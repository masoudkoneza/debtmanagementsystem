# .gitignore
#
# Files and directories that must NEVER be committed to the repository.
# Spec non-negotiable: .env files, node_modules, __pycache__, migration files.

# ── Environment / secrets ──────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# Django migrations (spec requirement: do not commit migration files)
# The reviewer will run `python manage.py migrate` after cloning.
*/migrations/*.py
!*/migrations/__init__.py   # Keep the __init__ so the package is importable

# Django static files
staticfiles/
media/

# ── Node / Frontend ─────────────────────────────────────────────────────────
node_modules/
dist/
.cache/

# Vite build output
frontend/dist/

# ── Testing & coverage ──────────────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/

# ── IDEs ────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
