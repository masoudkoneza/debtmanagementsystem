# .env.example
#
# Copy this file to .env and fill in real values before running the project.
#
#   cp .env.example .env
#
# NEVER commit .env to git — it is listed in .gitignore.
# This file (.env.example) is safe to commit; it contains only placeholders.

# ── Django ─────────────────────────────────────────────────────────────────

# A long, random string used by Django for cryptographic signing.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here-replace-before-running

# Set to True in development, False in production.
# Django shows detailed error pages when DEBUG=True — never use in production.
DEBUG=True

# Comma-separated list of hostnames Django will respond to.
# Include 'localhost' and '127.0.0.1' for local development.
ALLOWED_HOSTS=localhost,127.0.0.1

# ── PostgreSQL ──────────────────────────────────────────────────────────────

# Database name, user, and password.
# These values must match the POSTGRES_* environment variables on the db service.
DB_NAME=dms
DB_USER=dms_user
DB_PASSWORD=change_this_password

# Host and port — use 'db' (the Docker Compose service name) when running in Docker.
# Use 'localhost' when connecting from outside Docker (e.g. a local psql client).
DB_HOST=db
DB_PORT=5432

# ── Frontend ────────────────────────────────────────────────────────────────

# Base URL the Axios client uses for API requests.
# When running behind the Vite proxy (docker-compose), leave this empty
# so /api/* requests are proxied to the backend service automatically.
# Set to http://localhost:8000 when running the frontend outside Docker.
VITE_API_BASE_URL=
